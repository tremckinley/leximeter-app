# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (Render sets this automatically)
PORT=3001

# CORS allowed origin — set this to your production frontend URL in Render dashboard
# e.g., https://your-app.netlify.app
ALLOWED_ORIGIN=http://localhost:5173

# ─── Client (must be prefixed with VITE_ to be exposed to the browser) ─────────
# Leave empty in development — the Vite proxy forwards /api to localhost:3001
# Set to your Render API URL in production, e.g., https://your-api.onrender.com
VITE_API_URL=
